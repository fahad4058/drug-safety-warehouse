# Copy to .env and fill in the four values. .env is gitignored.
#
#   cp .env.example .env
#   source .env
#
# The file uses `export`, so a plain `source .env` is enough.

# Workspace URL, with the scheme. Example:
#   https://dbc-xxxxxxxx-xxxx.cloud.databricks.com
export DATABRICKS_HOST=

# SQL warehouse HTTP path, from the warehouse's Connection details tab:
#   /sql/1.0/warehouses/<warehouse-id>
export DATABRICKS_HTTP_PATH=

# Personal access token: Settings -> Developer -> Access tokens.
# dbt reads this name; the DBT_ENV_SECRET_ prefix makes dbt scrub the value
# out of its logs.
export DBT_ENV_SECRET_DATABRICKS_TOKEN=

# The same token again, under the name the Databricks CLI expects. The
# Makefile's `databricks fs cp` steps read this one; dbt reads the one above.
export DATABRICKS_TOKEN=
